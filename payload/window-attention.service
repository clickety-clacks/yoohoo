[Unit]
Description=Track and render Hyprland windows requesting attention
Documentation=file:%h/.local/share/window-attention/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/window-attention daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
