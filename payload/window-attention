def _load_bundled_hub():
    """Load only the helper shipped with this daemon, never sys.path data."""
    import importlib.util

    candidates = (
        Path(__file__).resolve().parent.parent / "share/window-attention/agentd_hub.py",
        Path(__file__).with_name("agentd_hub.py"),
    )
    path = next((item for item in candidates if item.is_file()), None)
    if path is None:
        raise ModuleNotFoundError("bundled agentd_hub.py is missing")
    spec = importlib.util.spec_from_file_location("agentd_hub", path)
    if spec is None or spec.loader is None:
        raise ImportError("bundled agentd_hub.py cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    # Dataclasses and the bundled resolver expect the module to be registered
    # while its top-level code executes.
    sys.modules["agentd_hub"] = module
    spec.loader.exec_module(module)
    return module


